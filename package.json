{
  "name": "pharmatrak-backend",
  "version": "1.0.0",
  "description": "Backend for pharmacy store management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --config tests/jest.config.js",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "test:fda": "node tests/manual-fda-test.js",
    "test:fda:interactive": "node tests/manual-fda-test.js --interactive",
    "test:fda:offline": "node tests/manual-fda-test.js --skip-api",
    "create-admin": "node scripts/createAdmin.js",
    "add-test-data": "node scripts/addTestData.js",
    "frontend": "cd frontend && npm start",
    "setup:frontend": "cd frontend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "restart": "./restart.sh",
    "dev:both": "concurrently \"npm run dev\" \"npm run frontend\"",
    "stop": "pkill -f 'node server.js' && pkill -f 'react-scripts start'"
  },
  "keywords": [
    "pharmacy",
    "store",
    "management",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.3",
    "node-cache": "^5.1.2",
    "puppeteer": "^24.16.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.0.5",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
