{
  "name": "pharmatrak-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaTraK pharmacy management system frontend with accessibility features",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.7",
    "bootswatch": "^5.3.7",
    "dompurify": "^3.2.6",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.2.0",
    "react-router-bootstrap": "^0.26.3",
    "react-router-dom": "^7.8.0",
    "react-scripts": "5.0.1",
    "sharp": "^0.34.3",
    "web-vitals": "^2.1.4",
    "jest-axe": "^7.0.0",
    "axe-core": "^4.6.3",
    "jsdom": "^21.1.0",
    "marked": "^4.2.12",
    "prismjs": "^1.29.0"
  },
  "scripts": {
    "start": "NODE_OPTIONS='--no-deprecation' react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:accessibility": "npm test -- --testPathPattern=accessibility",
    "test:coverage": "npm test -- --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "accessibility:audit": "node src/tools/accessibility-audit.js",
    "docs:build": "node src/docs/build-docs.js",
    "docs:serve": "serve -s src/docs -l 3002"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "jsx-a11y"
    ],
    "rules": {
      "jsx-a11y/anchor-is-valid": "error",
      "jsx-a11y/aria-props": "error",
      "jsx-a11y/aria-proptypes": "error",
      "jsx-a11y/aria-unsupported-elements": "error",
      "jsx-a11y/role-has-required-aria-props": "error",
      "jsx-a11y/role-supports-aria-props": "error",
      "jsx-a11y/img-redundant-alt": "error",
      "jsx-a11y/label-has-associated-control": "error",
      "jsx-a11y/no-aria-hidden-on-focusable": "error",
      "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
      "jsx-a11y/no-noninteractive-element-to-interactive-role": "error"
    }
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|react-router-dom|@remix-run/router)/)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom/extend-expect"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/**/*.test.{js,jsx}",
      "!src/**/*.stories.{js,jsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/user-event": "^14.6.1",
    "axios-mock-adapter": "^2.1.0",
    "msw": "^2.10.4",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "serve": "^14.2.0"
  },
  "keywords": [
    "pharmacy",
    "healthcare",
    "react",
    "accessibility",
    "wcag",
    "pharmacy-management"
  ],
  "author": "PharmaTraK Development Team",
  "license": "MIT",
  "proxy": "http://localhost:3001"
}
